---
/**
 * The synthetic data service, built on Simula.
 *
 * A user-facing service page, written for the people who approve the
 * spend as much as the engineers who raise it. It borrows the Simula
 * plate (grained indigo, the wordmark in Fraunces italic) and gives it
 * more room: the hero is a pinned scroll in which the wordmark blurs
 * out and the service headline comes into focus over the same cloth.
 *
 * Numbers are from the Simula research log (the 1,000-row job-posting
 * run and the 10K e-commerce run) and Pranav's token figure. The tail
 * chart, the scatter and the spec tree are illustrations, not data.
 */
import V2Layout from '@/layouts/V2Layout.astro';
import CoverageTree from '@/components/v2/CoverageTree.astro';

const OSS_URL = '/open-source/simula';
const GITHUB_URL = 'https://github.com/Mercity-AI/Simula';

/* Seeded, so the illustrations are identical on every build. */
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/* ── The tail chart: collected data thins out to the right; what we
   generate tops each bin up to the coverage the model needs. ──── */
const TARGET = 0.3;
const tailRand = rng(4102);
const BIN_COUNT = 28;
const rawBins = Array.from({ length: BIN_COUNT }, (_, i) => {
  let c = 0.9 * Math.exp(-i / 3.9) * (0.86 + tailRand() * 0.28);
  if (i > 12 && tailRand() < 0.4) c = 0;
  c = Math.min(0.94, i > 12 ? c : Math.max(c, 0.02));
  return { c, s: Math.max(0, TARGET - c) };
});
const firstSynth = rawBins.findIndex((b) => b.s > 0);
const bins = rawBins.map((b, i) => ({
  ...b,
  // 0 → 1 across the bins that get generated rows, left to right.
  k: b.s > 0 ? (i - firstSynth) / (BIN_COUNT - firstSynth) : 0,
}));

/* ── Entry A: a scatter of what a client already has, clustered,
   with the empty regions marked. ─────────────────────────────── */
const gaps = [
  { x: 332, y: 70, r: 38, label: 'empty' },
  { x: 86, y: 214, r: 30, label: 'empty' },
];
const scatterRand = rng(7719);
const gauss = () => {
  const u = 1 - scatterRand();
  const v = scatterRand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};
const clusters = [
  { x: 150, y: 118, sx: 34, sy: 24, n: 78 },
  { x: 250, y: 176, sx: 28, sy: 20, n: 46 },
];
const points: { x: number; y: number }[] = [];
for (const cl of clusters) {
  for (let i = 0; i < cl.n; i++) points.push({ x: cl.x + gauss() * cl.sx, y: cl.y + gauss() * cl.sy });
}
for (let i = 0; i < 14; i++) points.push({ x: 24 + scatterRand() * 352, y: 20 + scatterRand() * 236 });
const scatter = points.filter(
  (p) =>
    p.x > 10 && p.x < 390 && p.y > 10 && p.y < 266 && gaps.every((g) => Math.hypot(p.x - g.x, p.y - g.y) > g.r + 8),
);

/* ── Entry B: a description becomes a tree. ────────────────────── */
const specFactors = ['product line', 'shopper intent', 'phrasing'];
const ROOT = { x: 30, y: 140 };
const factorNodes = specFactors.map((label, i) => ({ label, x: 168, y: 52 + i * 88 }));
const leafNodes = factorNodes.flatMap((f) => [-24, 0, 24].map((dy) => ({ x: 318, y: f.y + dy, fy: f.y })));
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  return `M${a.x} ${a.y} C${mx} ${a.y}, ${mx} ${b.y}, ${b.x} ${b.y}`;
};

/* ── Copy ───────────────────────────────────────────────────────── */
const shortfalls = [
  {
    tag: 'Scarcity',
    title: 'Not enough of the data exists.',
    cost: 'You cannot build the model at all, or you spend months and a large budget collecting data before training starts.',
  },
  {
    tag: 'Access',
    title: 'The data exists, but you cannot legally use it.',
    cost: 'Compliance work slows every procurement cycle, and a slip means regulatory and fine exposure.',
  },
  {
    tag: 'The long tail',
    title: 'The data misses the cases that matter.',
    cost: 'The model fails on the edge cases it was built to handle in the first place.',
  },
  {
    tag: 'Quality',
    title: 'The data is dirty, mislabelled or skewed.',
    cost: 'Labelling eats into gross margin, and skewed data produces discriminatory output.',
  },
  {
    tag: 'Safety',
    title: 'Attack and abuse data you cannot ethically collect.',
    cost: 'Without adversarial examples, the safety systems around the model do not hold.',
  },
  {
    tag: 'Evaluation',
    title: 'Your test data has leaked into training.',
    cost: 'Scores look good, you ship with confidence, and the model does not work.',
  },
];

const consequences = [
  {
    title: 'Edge cases break the product.',
    body: 'Either the model never ships, or a weak one does and users leave. What you lose is customer trust.',
  },
  {
    title: 'Costs climb.',
    body: 'Collecting and labelling data by hand is slow and expensive, and it comes straight out of your margins.',
  },
  {
    title: 'Competitors move first.',
    body: 'In regulated markets, teams already training on synthetic data reach customers you cannot.',
  },
];

const checks = [
  { title: 'A critic on every row', body: 'A separate model checks each row against your rules and rejects it with a reason.' },
  { title: 'Lineage on every row', body: 'Each row records the taxonomy nodes and the prompt that produced it.' },
  { title: 'Kept apart from your tests', body: 'Rows that overlap your test set are dropped, so your scores measure the model.' },
];

const loopSteps = [
  {
    title: 'We generate a first tranche.',
    body: 'The first half of the dataset, generated against the taxonomy, with a coverage report showing what it reaches.',
  },
  {
    title: 'You review it.',
    body: 'Your team checks it against what they know and flags what is off: missed cases, wrong distributions, edge cases that need more weight.',
  },
  {
    title: 'We refine it.',
    body: 'We fold the corrections back into the taxonomy and the generation, and move toward the final dataset.',
  },
];

const outcomes = [
  {
    side: 'For your business',
    items: [
      { title: 'Faster to market', body: 'No months spent collecting and labelling data before training can start.' },
      { title: 'Regulated markets open up', body: 'Train for domains where you could not touch the data before.' },
      { title: 'Lower data costs', body: 'Less manual labelling, and less pressure on gross margin.' },
    ],
  },
  {
    side: 'For your users',
    items: [
      { title: 'The product works on their case', body: 'Including the rare cases they hit most, which is where trust is won.' },
      { title: 'Their data is protected', body: 'Customer records do not have to go into your training set.' },
      { title: 'A story you can sell', body: 'Evidence of coverage and testing to show your own buyers.' },
    ],
  },
];

const proof = [
  { count: 100, suffix: 'B+', label: 'tokens generated', note: 'of synthetic data for client projects' },
  { count: 1739, suffix: '', of: '/ 1,740', label: 'leaves reached', note: 'of the taxonomy in our 10K e-commerce run' },
  { count: 96, suffix: '%', label: 'accept rate', note: 'rows passed by the critic, 1,000-row run' },
  { count: 0, suffix: '', label: 'duplicates', note: 'in the same run, by 13-gram overlap' },
];

const audiences = [
  {
    title: 'Teams that train or evaluate their own models',
    points: [
      'A domain-specific problem where edge cases are hard to find',
      'Data that is access-constrained, where compliance is required',
      'An evaluation set the team does not fully trust',
      'A high cost when the model gets it wrong',
      'Prompting an LLM for data has already hit its limit',
    ],
  },
  {
    title: 'AI firms whose clients need custom data',
    points: [
      'Client work that depends on data nobody has collected',
      'Domain knowledge on your side, generation research on ours',
      'Datasets too specific for an off-the-shelf generator',
      'A pipeline your team does not have the people to build',
    ],
  },
];

const uses = ['Custom LLMs', 'Domain models', 'Agents', 'RAG', 'Classification', 'Domain search', 'Evaluation sets'];

const industries = [
  'Financial services',
  'Healthcare and life sciences',
  'Cybersecurity',
  'Insurance',
  'Manufacturing',
  'Retail and e-commerce',
  'IT and telecom',
  'Enterprise AI',
];

const faqs = [
  {
    q: 'Can our ML team build this in-house?',
    a: 'Usually not without pulling people off the product. Your ML team’s job is the product model; the pipeline that feeds it is research work, a different specialisation that most teams do not have to spare. Large enterprises with a recurring need sometimes build their own, and we can help set that up too.',
  },
  {
    q: 'What if we do not have any data?',
    a: 'That is common. If you know the domain, you can describe what the data has to contain, and we build the taxonomy from that description instead.',
  },
  {
    q: 'How do we know the dataset covers what matters?',
    a: 'Every row records the taxonomy nodes it came from, so coverage is a count, not an estimate. Each round comes with a coverage report, and your team reviews the rows before the next round starts.',
  },
  {
    q: 'Who owns the dataset?',
    a: 'You do. The data, the generation code, the filters and the coverage report are all yours at the end of the engagement.',
  },
  {
    q: 'Is Simula open source?',
    a: 'Yes. Simula is on GitHub and you can run it yourself. The service is for when you want us to design the taxonomy, run the generation and review the results with you.',
  },
];
---

<V2Layout
  title="Synthetic data generation"
  description="We generate synthetic training data for the cases your model gets wrong: rare, regulated or missing. Built on Simula, our open-source pipeline, and reviewed with your team in rounds."
  path="/services/simula"
  image="/simula-og.jpg"
>
  <!-- ═══ HERO: a pinned scroll on the plate ═════════════════════ -->
  <section class="sh" data-sh>
    <div class="sh-stage" data-vsticky="0">
      <div class="sh-plate" aria-hidden="true">
        <canvas class="sh-sharp" data-backdrop="plate" data-seed="7731" data-dpr="1"></canvas>
        <canvas class="sh-soft" data-backdrop="plate" data-seed="7731" data-dpr="0.35"></canvas>
        <span class="sh-light l1"></span>
        <span class="sh-light l2"></span>
        <span class="sh-light l3"></span>
        <span class="sh-shade"></span>
      </div>

      <div class="sh-word" aria-hidden="true">
        <span class="sh-word-in">Simula</span>
        <span class="sh-tag">Synthetic training data, built for your domain</span>
      </div>

      <div class="sh-copy" data-sh-copy>
        <div class="shell sh-copy-in">
          <h1 class="sh-in">Training data for the cases your model gets wrong.</h1>
          <p class="sh-in d1">
            The data you can collect clusters around the common cases. The rare, regulated and missing ones are where
            your model fails. We map your domain as a taxonomy and generate datasets that cover all of it, with Simula,
            the pipeline we open-sourced.
          </p>
          <div class="sh-actions sh-in d2">
            <a class="btn-l" href="/contact">
              <span class="btn-l-fill"></span>
              <span class="btn-l-label">Talk to us</span>
              <span class="btn-l-label" aria-hidden="true">→</span>
            </a>
            <a class="quiet on-dark" href="#gap">See how it works<span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>

      <div class="sh-cue" aria-hidden="true">
        <span>Scroll</span>
        <i></i>
      </div>
    </div>
  </section>

  <!-- ═══ THE GAP ════════════════════════════════════════════════ -->
  <section class="band" id="gap">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Your model fails where your data runs out.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Collected data piles up around the common cases. The rare, regulated and unrecorded cases sit in a thin tail,
          and those are usually the cases the model was built for. Collecting more of the same data does not reach them.
        </p>
      </div>

      <figure class="tail rv" data-rv style="--rv-delay:200ms" data-tail>
        <div class="tail-legend">
          <span><i class="sw sw-c"></i>Data you collected</span>
          <span><i class="sw sw-s"></i>Data we generate</span>
          <span><i class="sw sw-t"></i>Coverage the model needs</span>
        </div>
        <div class="tail-plot">
          <div class="tail-target" style={`bottom:${TARGET * 100}%`}></div>
          {
            bins.map((b) => (
              <div class="tail-bin">
                <span class="tail-c" style={`height:${(b.c * 100).toFixed(2)}%`} />
                {b.s > 0 && <span class="tail-s" style={`height:${(b.s * 100).toFixed(2)}%;--k:${b.k.toFixed(3)}`} />}
              </div>
            ))
          }
        </div>
        <div class="tail-axis">
          <span>Common cases</span>
          <i></i>
          <span>Edge cases</span>
        </div>
        <figcaption>
          An illustration. We generate rows where the tail falls short and leave the common cases as you collected them.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ SIX SHORTFALLS ═════════════════════════════════════════ -->
  <section class="band band-tint" id="shortfalls">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Six ways collected data falls short.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Most teams hit more than one. Each has a cost the business feels before the ML team does.
      </p>
      <div class="short-grid">
        {
          shortfalls.map((s, i) => (
            <article class="short rv" data-rv style={`--rv-delay:${80 + (i % 3) * 70}ms`}>
              <span class="short-tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>
                <span>What it costs</span>
                {s.cost}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ THE DEFAULT ════════════════════════════════════════════ -->
  <section class="dark">
    <canvas class="dark-bg" data-backdrop="plate" data-seed="2604" data-dpr="0.3" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <div class="shell dark-in">
      <h2 class="rv" data-rv>Skipping synthetic data does not mean nothing happens.</h2>
      <p class="dark-sub rv" data-rv style="--rv-delay:100ms">It means you fall back on a worse option.</p>
      <div class="dark-grid">
        {
          consequences.map((c, i) => (
            <div class="dark-item rv" data-rv style={`--rv-delay:${180 + i * 90}ms`}>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ HOW: THE TAXONOMY ══════════════════════════════════════ -->
  <section class="band band-tint" id="how">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">We map your domain before we generate a row.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Simula splits the space your model has to handle into factors, and grows each factor into a tree. Every row
          takes one node from each factor, so coverage becomes something we count, and the edge cases are planned for
          from the start.
        </p>
      </div>
      <CoverageTree />
      <div class="checks">
        {
          checks.map((c, i) => (
            <div class="check rv" data-rv style={`--rv-delay:${100 + i * 70}ms`}>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))
        }
      </div>
      <a class="quiet how-link rv" data-rv href={OSS_URL}>Simula is open source. See how it works<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ═══ TWO WAYS IN ════════════════════════════════════════════ -->
  <section class="band" id="start">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Two ways to start.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        It depends on what you already have. Either way, the taxonomy comes first.
      </p>

      <div class="entry rv" data-rv style="--rv-delay:220ms" data-tabs>
        <div class="entry-tabs" role="tablist" aria-label="How an engagement starts">
          <button type="button" role="tab" id="tab-a" aria-controls="panel-a" aria-selected="true">
            <b>A</b> You have some data
          </button>
          <button type="button" role="tab" id="tab-b" aria-controls="panel-b" aria-selected="false" tabindex="-1">
            <b>B</b> You have the domain expertise
          </button>
          <span class="entry-ink" aria-hidden="true"></span>
        </div>

        <div class="entry-panel" role="tabpanel" id="panel-a" aria-labelledby="tab-a">
          <div class="entry-text">
            <h3>We start from your data.</h3>
            <p>
              You bring data you have collected, or data you have generated yourself from an LLM and other sources. We
              profile it to see what is there and what is missing, where it clusters and where the tail is empty, and
              build the taxonomy around those gaps.
            </p>
            <ol class="entry-steps">
              <li>Profile what you have</li>
              <li>Find the empty regions</li>
              <li>Build the taxonomy around them</li>
            </ol>
          </div>
          <figure class="entry-art">
            <svg viewBox="0 0 400 276" role="img" aria-label="A scatter of existing data in two clusters, with two empty regions marked">
              {scatter.map((p) => <circle class="pt" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.6" />)}
              {
                gaps.map((g) => (
                  <g class="gap">
                    <circle cx={g.x} cy={g.y} r={g.r} />
                    <text x={g.x} y={g.y + 3.5}>{g.label}</text>
                  </g>
                ))
              }
            </svg>
            <figcaption>An illustration: your data, profiled. Two regions nothing reaches.</figcaption>
          </figure>
        </div>

        <div class="entry-panel" role="tabpanel" id="panel-b" aria-labelledby="tab-b" hidden>
          <div class="entry-text">
            <h3>We start from your specification.</h3>
            <p>
              You cannot hand us data, but you know the domain. You describe what the data has to contain, and we turn
              that description into the taxonomy and generate against it.
            </p>
            <p class="entry-ex">
              An e-commerce company needs search queries for its search system. They describe the query space: their
              product lines, what shoppers are after, and how they phrase it. That description becomes the tree.
            </p>
          </div>
          <figure class="entry-art">
            <svg viewBox="0 0 400 276" role="img" aria-label="A description split into three factors, each with three leaves">
              {factorNodes.map((f) => <path class="ln" d={curve(ROOT, f)} />)}
              {leafNodes.map((l) => <path class="ln" d={curve({ x: 168, y: l.fy }, l)} />)}
              <rect class="root" x={ROOT.x - 7} y={ROOT.y - 7} width="14" height="14" />
              <text class="lbl" x={ROOT.x - 8} y={ROOT.y + 26}>your description</text>
              {
                factorNodes.map((f) => (
                  <g>
                    <circle class="fac" cx={f.x} cy={f.y} r="5" />
                    <text class="lbl" x={f.x - 10} y={f.y - 13}>{f.label}</text>
                  </g>
                ))
              }
              {leafNodes.map((l) => <circle class="leaf" cx={l.x} cy={l.y} r="4.5" />)}
            </svg>
            <figcaption>An illustration: one description, three factors, nine leaves.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE LOOP ═══════════════════════════════════════════════ -->
  <section class="band band-tint" id="loop">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Then we build it with you, in rounds.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        The engagement is a build and review loop, not a single handoff. Your team’s domain knowledge goes into every
        round.
      </p>

      <div class="loop" data-loop>
        <div class="loop-rail" aria-hidden="true"><span class="loop-fill"></span></div>
        <ol class="loop-steps">
          {
            loopSteps.map((s, i) => (
              <li class="loop-step" data-step={i}>
                <span class="loop-node" aria-hidden="true"></span>
                <span class="loop-n">0{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
        <div class="loop-back" aria-hidden="true">
          <svg viewBox="0 0 1000 56" preserveAspectRatio="none">
            <path pathLength="1" d="M672 0 V30 Q672 46 656 46 H16 Q0 46 0 30 V2" />
          </svg>
          <span class="loop-arrow"></span>
          <span class="loop-label">Repeat until your team signs off</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ OUTCOMES AND PROOF ═════════════════════════════════════ -->
  <section class="band" id="outcomes">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">What changes when the data covers the space.</h2>
      <div class="out-grid">
        {
          outcomes.map((o, i) => (
            <div class="out-col rv" data-rv style={`--rv-delay:${140 + i * 90}ms`}>
              <span class="out-side">{o.side}</span>
              <ul>
                {o.items.map((it) => (
                  <li>
                    <h3>{it.title}</h3>
                    <p>{it.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <dl class="proof rv" data-rv style="--rv-delay:120ms">
        {
          proof.map((p) => (
            <div class="proof-cell">
              <dt>{p.label}</dt>
              <dd>
                <span class="proof-fig">
                  <span data-count={p.count} data-suffix={p.suffix}>
                    {p.count.toLocaleString('en-US')}
                    {p.suffix}
                  </span>
                  {p.of && <small>{p.of}</small>}
                </span>
                <span class="proof-note">{p.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="own rv" data-rv>
        Every dataset ships with its generation code, filters and coverage report. You own all of it.
      </p>
    </div>
  </section>

  <!-- ═══ WHO ════════════════════════════════════════════════════ -->
  <section class="band band-tint" id="who">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Who we work with.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Teams whose hard cases are rare, regulated or missing, and who cannot spare the people to build a rigorous
        generation pipeline in-house.
      </p>
      <div class="aud-grid">
        {
          audiences.map((a, i) => (
            <article class="aud rv" data-rv data-from={i === 0 ? 'left' : 'right'} style={`--rv-delay:${140 + i * 80}ms`}>
              <h3>{a.title}</h3>
              <ul>
                {a.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="uses rv" data-rv>
        <span class="uses-h">The data goes into</span>
        <ul>
          {uses.map((u) => <li>{u}</li>)}
        </ul>
      </div>
    </div>
    <div class="mq rv" data-rv>
      <div class="mq-track">
        {
          [0, 1].map((copy) => (
            <ul aria-hidden={copy === 1 ? 'true' : undefined}>
              {industries.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

