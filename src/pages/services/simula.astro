  }

  /* ══ THE GAP: the tail chart ═════════════════════════════════ */
  .tail {
    --q: 0;
    margin: 46.8px 0 0;
    padding: 24px 26px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .tail-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    font-family: var(--mono);
    font-size: 10.35px;
