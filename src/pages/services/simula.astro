    }
  }
  /* Deepens the lower left once the copy arrives, for contrast. */
  .sh-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, hsl(243 80% 16% / 0.55) 0%, hsl(243 80% 16% / 0.18) 55%, transparent 100%);
    opacity: var(--b0);
