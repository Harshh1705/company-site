    align-items: center;
    gap: 8px;
  }
  .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
  }
  .sw-c {
    background: var(--teal-500);
  }
  .sw-s {
    background: var(--indigo-500);
  }
  .sw-t {
    height: 0;
    width: 16px;
    border-top: 1.5px dashed var(--ink-2);
  }
  .tail-plot {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: clamp(2px, 0.5vw, 6px);
    height: clamp(180px, 24vw, 280px);
    margin-top: 26px;
    border-bottom: 1px solid var(--line-2);
  }
  .tail-bin {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column-reverse;
  }
  .tail-c {
    display: block;
    background: var(--teal-500);
    opacity: 0.85;
  }
  .tail-s {
    display: block;
    background: var(--indigo-500);
    transform-origin: bottom;
    transform: scaleY(clamp(0, calc(var(--q) * 2.4 - 0.25 - var(--k) * 1.05), 1));
  }
  .tail-target {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    border-top: 1.5px dashed var(--ink-2);
    pointer-events: none;
  }
  .tail-axis {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tail-axis i {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-2);
  }
  .tail-axis i::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--ink-3);
    border-right: 1px solid var(--ink-3);
    transform: rotate(45deg);
  }
  .tail figcaption {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 10.35px;
    line-height: 1.6;
    color: var(--n-400);
  }

  /* ══ SIX SHORTFALLS ══════════════════════════════════════════
     One flush grid, every edge shared. Unnumbered: the order does not
     matter. Hover draws an indigo rule across the top. */
  .short-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 46.8px;
    border-top: 1px solid var(--line);
