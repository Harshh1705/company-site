</V2Layout>

<script is:inline>
  /* ── Scroll-driven pieces ────────────────────────────────────────
     Three things follow the scroll: the hero (word out, copy in), the
     tail chart (generated rows grow into the tail) and the loop rail.
     Under the layout's virtual scroll, `v2scroll` fires inside its own
     frame after the wrapper moves, so we update synchronously there;
     native scrolling goes through one rAF. */
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const set = (el, k, v) => el.style.setProperty(k, v.toFixed(4));

    const hero = document.querySelector('[data-sh]');
    const stage = hero && hero.querySelector('.sh-stage');
    const copy = hero && hero.querySelector('[data-sh-copy]');
    const tail = document.querySelector('[data-tail]');
    const loop = document.querySelector('[data-loop]');
    const steps = loop ? [...loop.querySelectorAll('[data-step]')] : [];

    const finish = () => {
      if (hero) {
        ['--a', '--b0', '--b1', '--b2'].forEach((k) => set(hero, k, 1));
        copy.dataset.live = 'true';
      }
      if (tail) set(tail, '--q', 1);
      if (loop) {
        set(loop, '--r', 1);
        set(loop, '--arc', 1);
        steps.forEach((s) => (s.dataset.on = 'true'));
      }
    };
    if (reduce) {
      document.documentElement.dataset.still = 'true';
      finish();
      return;
    }

    const update = () => {
      const vh = window.innerHeight;
      if (hero) {
        const r = hero.getBoundingClientRect();
        const span = r.height - stage.offsetHeight;
        const p = span > 0 ? clamp(-r.top / span) : 1;
        set(hero, '--a', ease(clamp(p / 0.42)));
        [0, 1, 2].forEach((i) => set(hero, '--b' + i, ease(clamp((p - 0.26 - i * 0.08) / 0.32))));
        copy.dataset.live = p > 0.4 ? 'true' : 'false';
      }
      if (tail) {
        const r = tail.getBoundingClientRect();
        set(tail, '--q', clamp((vh * 0.92 - r.top) / (r.height + vh * 0.3)));
      }
      if (loop) {
        const r = loop.getBoundingClientRect();
        const t = clamp((vh * 0.82 - r.top) / (vh * 0.5));
        set(loop, '--r', t);
        set(loop, '--arc', clamp((t - 0.82) / 0.18));
        steps.forEach((s, i) => (s.dataset.on = t >= i / 3 + 0.02 ? 'true' : 'false'));
      }
    };

    let raf = 0;
    const req = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
    };
    window.addEventListener('scroll', () => (document.documentElement.dataset.vscroll ? null : req()), {
      passive: true,
    });
    window.addEventListener('v2scroll', update);
    window.addEventListener('resize', req);
    update();
  })();

  /* ── Counters: count up once, when the strip comes into view. ── */
  (() => {
    const nodes = [...document.querySelectorAll('[data-count]')];
    if (!nodes.length || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const fmt = (n) => Math.round(n).toLocaleString('en-US');
    nodes.forEach((n) => (n.textContent = '0' + n.dataset.suffix));
    const run = (n) => {
      const to = Number(n.dataset.count);
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 1400);
        n.textContent = fmt(to * (1 - Math.pow(1 - k, 4))) + n.dataset.suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.querySelectorAll('[data-count]').forEach(run);
          io.unobserve(e.target);
        });
      },
      { threshold: 0.4 }
    );
    const strip = nodes[0].closest('.proof');
    if (strip) io.observe(strip);
  })();

  /* ── Entry tabs: click, or arrow keys between the two. ──────────── */
  (() => {
    const root = document.querySelector('[data-tabs]');
    if (!root) return;
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const select = (tab, focus) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
      root.dataset.active = String(tabs.indexOf(tab));
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });
    root.dataset.active = '0';
  })();
</script>

<style>
  /* ── Shared bits ───────────────────────────────────────────── */
