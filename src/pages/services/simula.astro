  .short p span {
    margin-bottom: 6px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--n-400);
  }
  @media (max-width: 940px) {
    .short-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .short-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ THE DEFAULT: dark band over a blurred plate ═════════════ */
  .dark {
    position: relative;
    overflow: hidden;
    background: var(--n-900);
    color: var(--n-50);
  }
  .dark-bg {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    filter: blur(48px) saturate(1.2);
    opacity: 0.42;
  }
  .dark-in {
    position: relative;
    z-index: 1;
    padding-block: clamp(79.2px, 9.9vw, 131.4px);
  }
  .dark h2 {
