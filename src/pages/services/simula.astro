  /* ══ THE LOOP ════════════════════════════════════════════════
     A rail fills with the scroll and lights each step as it passes;
     then the return path draws back to the start. */
  .loop {
    --r: 0;
    --arc: 0;
    position: relative;
    margin-top: 52px;
  }
  .loop-rail {
    position: relative;
    height: 1px;
    background: var(--line-2);
  }
  .loop-fill {
    position: absolute;
    inset: 0;
    background: var(--indigo-600);
    transform-origin: left;
    transform: scaleX(var(--r));
  }
  .loop-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(24px, 3.4vw, 46.8px);
  }
  .loop-step {
    position: relative;
    padding-top: 30px;
  }
  .loop-node {
    position: absolute;
    left: 0;
    top: -6px;
    width: 11px;
    height: 11px;
    background: var(--n-100);
    border: 1px solid var(--line-2);
    transition:
      background 400ms var(--ease),
      border-color 400ms var(--ease),
      transform 400ms var(--ease);
  }
  .loop-step[data-on='true'] .loop-node {
    background: var(--indigo-600);
    border-color: var(--indigo-600);
    transform: rotate(45deg);
  }
  .loop-n {
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--n-400);
    transition: color 400ms var(--ease);
  }
  .loop-step[data-on='true'] .loop-n {
    color: var(--indigo-600);
  }
  .loop-step h3 {
    margin-top: 12px;
    font-family: var(--hero-serif);
    font-size: 22.5px;
    font-weight: 400;
    letter-spacing: -0.016em;
    line-height: 1.2;
  }
  .loop-step p {
    margin-top: 10px;
    max-width: 38ch;
    font-size: 13.5px;
    line-height: 1.74;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .loop-step h3,
  .loop-step p {
    opacity: 0.4;
    transition: opacity 500ms var(--ease);
  }
  .loop-step[data-on='true'] h3,
  .loop-step[data-on='true'] p {
    opacity: 1;
  }
  .loop-back {
    position: relative;
    margin-top: 26px;
    height: 56px;
  }
  .loop-back svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-back path {
    fill: none;
    stroke: var(--indigo-500);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--arc));
  }
  .loop-arrow {
    position: absolute;
    left: -4px;
    top: -2px;
    width: 9px;
    height: 9px;
    border-top: 1.2px solid var(--indigo-500);
    border-left: 1.2px solid var(--indigo-500);
    transform: rotate(45deg);
    opacity: clamp(0, calc(var(--arc) * 8 - 7), 1);
  }
  .loop-label {
    position: absolute;
    left: 33.6%;
    bottom: 0;
    transform: translate(-50%, 50%);
    padding: 3px 12px;
    background: var(--n-100);
    font-family: var(--mono);
