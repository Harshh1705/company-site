  }
  @keyframes focus-in {
    from {
      opacity: 0;
      filter: blur(24px);
      transform: scale(1.05);
      letter-spacing: 0.02em;
    }
  }

  .sh-copy {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .sh-copy[data-live='true'] {
    pointer-events: auto;
  }
