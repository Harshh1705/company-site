  }

  /* ══ HERO ═══════════════════════════════════════════════════════
     The section is taller than the screen; the stage pins for the
     extra height. --a runs 0 → 1 as the wordmark blurs away, --b0..2
     as the headline, lede and buttons come into focus. */
  .sh {
    --a: 0;
    --b0: 0;
    --b1: 0;
    --b2: 0;
    position: relative;
    height: 220svh;
    background: var(--indigo-700);
  }
  .sh-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: #fff;
    will-change: transform;
  }
  /* Under virtual scroll the layout emulates the stick with a
     transform (data-vsticky), so the stage needs a plain box. */
  :global(html[data-vscroll]) .sh-stage {
    position: relative;
  }
  .sh-plate {
    position: absolute;
    inset: 0;
    background: var(--indigo-600);
  }
  .sh-plate canvas {
    position: absolute;
    width: 100%;
    height: 100%;
  }
  .sh-sharp {
    inset: 0;
  }
  /* The same cloth at a third of the resolution, blurred, and faded
     in over the sharp one. A crossfade is far cheaper than animating
     a blur across the whole screen. */
  .sh-plate .sh-soft {
    inset: -8%;
    width: 116%;
    height: 116%;
    filter: blur(26px) saturate(1.15) brightness(1.06);
    opacity: var(--a);
  }
  /* Soft lights drifting on the cloth. Indigo and white only. */
  .sh-light {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(70px);
    mix-blend-mode: screen;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .sh-light.l1 {
    width: 46vw;
    height: 46vw;
    left: -10vw;
    top: -16vw;
    background: hsl(243 90% 72% / 0.5);
