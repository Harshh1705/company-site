  { icon: 'lineage', risk: 'Nobody knows where a row came from', fix: 'Each row carries its lineage: case, prompt, model and verdicts.' },
];

/* ── Two ways to start: the illustrations ──────────────────────── */
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const gaps = [
  { x: 332, y: 70, r: 38 },
  { x: 86, y: 214, r: 30 },
];
const scatterRand = rng(7719);
const gauss = () => {
  const u = 1 - scatterRand();
  const v = scatterRand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};
const points: { x: number; y: number }[] = [];
for (const cl of [
  { x: 150, y: 118, sx: 34, sy: 24, n: 78 },
  { x: 250, y: 176, sx: 28, sy: 20, n: 46 },
]) {
  for (let i = 0; i < cl.n; i++) points.push({ x: cl.x + gauss() * cl.sx, y: cl.y + gauss() * cl.sy });
}
for (let i = 0; i < 14; i++) points.push({ x: 24 + scatterRand() * 352, y: 20 + scatterRand() * 236 });
const scatter = points.filter(
  (p) =>
    p.x > 10 && p.x < 390 && p.y > 10 && p.y < 266 && gaps.every((g) => Math.hypot(p.x - g.x, p.y - g.y) > g.r + 8),
);
const ROOT = { x: 30, y: 140 };
const factorNodes = ['product line', 'shopper intent', 'phrasing'].map((label, i) => ({ label, x: 168, y: 52 + i * 88 }));
const leafNodes = factorNodes.flatMap((f) => [-24, 0, 24].map((dy) => ({ x: 318, y: f.y + dy, fy: f.y })));
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  return `M${a.x} ${a.y} C${mx} ${a.y}, ${mx} ${b.y}, ${b.x} ${b.y}`;
};

const starts = [
