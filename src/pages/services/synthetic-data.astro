/* Dealt round-robin into four columns, so reading order runs across
   the grid; the even columns sit lower for the staggered look. */
const dsColumns = [0, 1, 2, 3].map((c) => datasets.filter((_, i) => i % 4 === c));

/* ── Known failure modes, and the check for each ───────────────── */
const controls = [
