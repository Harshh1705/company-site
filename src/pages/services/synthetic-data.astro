---
/**
 * Synthetic data generation, as a service.
 *
 * Written for buyers at the bottom of the funnel: they know the problem
 * and they know synthetic data is the answer, so the page has to show
 * that we can do it for them and have done it before. Every section is
 * skimmable: icons and short lines first, detail only in the FAQ.
 *
 * The hero is a pinned scroll on `sdStrata` (the Simula plate's indigo
 * cloth cut into the strata bleed from /design.html). The wordmark
 * blurs away and the offer comes into focus.
 *
 * Figures: "100B+" stands in for Pranav's "hundreds of billions of
 * tokens"; the dataset count is the hand count on the home page; the
 * run figures are from the Simula research log. The scatter and the
 * tree under "Two ways to start" are illustrations.
 */
import { getCollection } from 'astro:content';
import V2Layout from '@/layouts/V2Layout.astro';
import CoverageTree from '@/components/v2/CoverageTree.astro';

const OSS_URL = '/open-source/simula';
const GITHUB_URL = 'https://github.com/Mercity-AI/Simula';
const LOG_URL = '/research/building-simula-our-synthetic-data-generation-library';
const HF_DATASETS_URL = 'https://huggingface.co/datasets?author=Mercity';

const writeups = [...(await getCollection('posts')), ...(await getCollection('research'))];
const firstYear = Math.min(...writeups.map((e) => e.data.publishedAt.getFullYear()));

/* Line icons on a 24 grid, drawn with currentColor. */
const ICON: Record<string, string> = {
  sft: '<path d="M4 5h16v10H10l-6 4z"/><path d="M8 9h8M8 12h5"/>',
  chat: '<path d="M3 4h12v8H8l-5 3.5z"/><path d="M18 8h3v11l-4-3h-7v-2"/>',
  agent: '<rect x="3" y="4" width="6" height="6"/><rect x="15" y="14" width="6" height="6"/><path d="M9 7h4v10h2"/><circle cx="13" cy="12" r="1.2"/>',
  rag: '<path d="M13 3H6v18h6"/><path d="M13 3l4 4v3"/><path d="M13 3v4h4"/><circle cx="16.5" cy="16.5" r="3.5"/><path d="M19 19l2.5 2.5"/>',
  extract: '<path d="M8 4c-2 0-2.5 1-2.5 3v2c0 1.6-.8 3-2 3 1.2 0 2 1.4 2 3v2c0 2 .5 3 2.5 3"/><path d="M16 4c2 0 2.5 1 2.5 3v2c0 1.6.8 3 2 3-1.2 0-2 1.4-2 3v2c0 2-.5 3-2.5 3"/><path d="M10 12h4"/>',
  classify: '<rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><circle cx="16.5" cy="16.5" r="3.5"/>',
  evalset: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12l6.5-6.5"/><path d="M16 5.5h3v3"/>',
  redteam: '<path d="M12 3l8 3v6c0 4.8-3.4 8-8 9-4.6-1-8-4.2-8-9V6z"/><path d="M12 8v5M12 16v.6"/>',
  scarcity: '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13"/><path d="M5 12c0 1.4 3.1 2.5 7 2.5" stroke-dasharray="2 2.5"/>',
  access: '<rect x="5" y="11" width="14" height="10"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><path d="M12 15v2.5"/>',
  tail: '<path d="M3 3v18h18"/><path d="M5 5c3 0 4 11 16 12"/><circle cx="18" cy="16.6" r="1.3"/>',
  quality: '<path d="M4 5h16l-6 7.5V19l-4 2v-8.5z"/>',
  safety: '<circle cx="12" cy="12" r="6.5"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/>',
  leak: '<path d="M9 3h6"/><path d="M10 3v6l-5.2 9.2A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-2.8L14 9V3"/><path d="M7.5 15h9"/>',
  repeat: '<rect x="8" y="8" width="12" height="12"/><path d="M16 8V4H4v12h4"/>',
  wrong: '<circle cx="12" cy="12" r="8.5"/><path d="M9 9l6 6M15 9l-6 6"/>',
  same: '<path d="M5 9h14M5 15h14"/>',
  lineage: '<circle cx="6" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="12" r="2"/><path d="M6 7v10M6 12h10"/>',
  map: '<circle cx="4.5" cy="12" r="1.8"/><path d="M6.3 12H9M9 6v12M9 6h4M9 12h4M9 18h4"/><circle cx="15.5" cy="6" r="1.6"/><circle cx="15.5" cy="12" r="1.6"/><circle cx="15.5" cy="18" r="1.6"/>',
};

/* ── Proof strip, right under the hero ─────────────────────────── */
const strip = [
  { count: 100, suffix: 'B+', label: 'tokens of synthetic data', note: 'generated for client projects' },
  // Hand count of public repos under huggingface.co/Mercity, as on the home page.
  { count: 12, suffix: '', label: 'open datasets', note: 'published on Hugging Face' },
  { count: writeups.length, suffix: '', label: 'write-ups', note: `on our research, since ${firstYear}` },
];

/* ── The six problems, around one hub ──────────────────────────── */
const problems = [
  { icon: 'scarcity', title: 'Scarcity', line: 'Too little data to train on' },
  { icon: 'access', title: 'Access', line: 'Data you cannot legally use' },
  { icon: 'tail', title: 'The long tail', line: 'Edge cases nobody recorded' },
  { icon: 'quality', title: 'Quality', line: 'Labels that are noisy or skewed' },
  { icon: 'safety', title: 'Safety', line: 'Attacks you cannot ethically collect' },
  { icon: 'leak', title: 'Evaluation', line: 'Test sets you cannot trust' },
];

/* ── What we generate ──────────────────────────────────────────── */
const kinds = [
  { icon: 'sft', title: 'Instruction and SFT sets', line: 'Prompt and response pairs that teach a model your task.' },
  { icon: 'chat', title: 'Multi-turn conversations', line: 'Dialogues for assistants, including the turns that go wrong.' },
  { icon: 'agent', title: 'Agent and tool-use traces', line: 'Step-by-step trajectories with tool calls and results.' },
  { icon: 'rag', title: 'RAG question sets', line: 'Questions and answers grounded in your documents.' },
  { icon: 'extract', title: 'Structured extraction', line: 'Text paired with the fields your system has to pull out.' },
  { icon: 'classify', title: 'Classification sets', line: 'Labelled examples, weighted toward the rare classes.' },
  { icon: 'evalset', title: 'Evaluation sets', line: 'Benchmarks for your domain, kept apart from training.' },
  { icon: 'redteam', title: 'Adversarial and red-team data', line: 'Attacks, abuse and jailbreaks for your safety systems.' },
];

/* ── Known failure modes, and the check for each ───────────────── */
const controls = [
  { icon: 'repeat', risk: 'It repeats the common case', fix: 'Every case is planned in a taxonomy first, so coverage is counted.' },
  { icon: 'wrong', risk: 'Rows look right and are wrong', fix: 'A separate critic model checks every row against your rules.' },
  { icon: 'same', risk: 'Same spec, same row', fix: 'Several briefs are drafted per case and one is picked at random.' },
  { icon: 'leak', risk: 'Test data leaks into training', fix: 'Rows that overlap your test set are found and dropped.' },
  { icon: 'lineage', risk: 'Nobody knows where a row came from', fix: 'Each row carries its lineage: case, prompt, model and verdicts.' },
];

/* ── Two ways to start: the illustrations ──────────────────────── */
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const gaps = [
  { x: 332, y: 70, r: 38 },
  { x: 86, y: 214, r: 30 },
];
const scatterRand = rng(7719);
const gauss = () => {
  const u = 1 - scatterRand();
  const v = scatterRand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};
const points: { x: number; y: number }[] = [];
for (const cl of [
  { x: 150, y: 118, sx: 34, sy: 24, n: 78 },
  { x: 250, y: 176, sx: 28, sy: 20, n: 46 },
]) {
  for (let i = 0; i < cl.n; i++) points.push({ x: cl.x + gauss() * cl.sx, y: cl.y + gauss() * cl.sy });
}
for (let i = 0; i < 14; i++) points.push({ x: 24 + scatterRand() * 352, y: 20 + scatterRand() * 236 });
const scatter = points.filter(
  (p) =>
    p.x > 10 && p.x < 390 && p.y > 10 && p.y < 266 && gaps.every((g) => Math.hypot(p.x - g.x, p.y - g.y) > g.r + 8),
);
const ROOT = { x: 30, y: 140 };
const factorNodes = ['product line', 'shopper intent', 'phrasing'].map((label, i) => ({ label, x: 168, y: 52 + i * 88 }));
const leafNodes = factorNodes.flatMap((f) => [-24, 0, 24].map((dy) => ({ x: 318, y: f.y + dy, fy: f.y })));
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  return `M${a.x} ${a.y} C${mx} ${a.y}, ${mx} ${b.y}, ${b.x} ${b.y}`;
};

const starts = [
  {
    key: 'A',
    title: 'You have some data.',
    body: 'Collected, or generated yourself. We profile it to find where it clusters and where the tail is empty, and build the taxonomy around the gaps.',
    steps: ['Profile what you have', 'Find the empty regions', 'Plan the taxonomy around them'],
  },
  {
    key: 'B',
    title: 'You have the domain expertise.',
    body: 'No data to share, but you know the domain. You describe what the data has to contain, and we turn that description into the taxonomy.',
    steps: ['Describe the space', 'We turn it into a taxonomy', 'Generate against it'],
  },
];

const loopSteps = [
  { title: 'We generate a first tranche.', body: 'Built against the taxonomy, with a coverage report.' },
  { title: 'You review it.', body: 'Your team flags missed cases, wrong distributions and edge cases that need more weight.' },
  { title: 'We refine it.', body: 'Corrections go back into the taxonomy and the generation, toward the final dataset.' },
];

const deliverables = [
  'The dataset, in the format your pipeline takes',
  'The taxonomy it was generated from',
  'The generation code and filters',
  'A coverage and evaluation report',
  'Lineage on every row',
];

const runStats = [
  { count: 1739, suffix: '', of: '/ 1,740', label: 'leaves reached', note: 'of the taxonomy, 10K e-commerce run' },
  { count: 96, suffix: '%', label: 'accept rate', note: 'rows passed by the critic, 1,000-row run' },
  { count: 0, suffix: '', label: 'duplicates', note: 'in the same run, by 13-gram overlap' },
  { count: 84, suffix: ' min', label: 'wall time', note: 'for the 1,000-row run' },
];

const uses = ['Custom LLMs', 'Domain models', 'Agents', 'RAG', 'Classification', 'Domain search', 'Evaluation'];
const industries = [
  'Financial services',
  'Healthcare and life sciences',
  'Cybersecurity',
  'Insurance',
  'Manufacturing',
  'Retail and e-commerce',
  'IT and telecom',
  'Enterprise AI',
];

const faqs = [
  {
    q: 'Will training on synthetic data degrade our model?',
    a: 'Degradation comes from a model training on its own unchecked output, round after round. We generate against a plan, check every row with a separate critic model, and judge each round against an evaluation we agree with you before scaling up.',
  },
  {
    q: 'Do you need access to our data?',
    a: 'No. If you can describe the domain, we can generate from the description alone. If you share samples, we use them to find what is missing.',
  },
  {
    q: 'Who owns the dataset, and can we train on it?',
    a: 'You own the dataset, the taxonomy, the generation code and the reports. Every row records the model that generated it, so your legal team can check that model’s terms for training use.',
  },
  {
    q: 'How do we know it will improve our model?',
    a: 'We agree the evaluation first. The first tranche comes back for your team to review, and to test against that evaluation, before we generate the rest.',
  },
  {
    q: 'How much data can you generate?',
    a: 'We have generated hundreds of billions of tokens for client projects. The volume is set by what your model needs, and the coverage report shows what each extra batch adds.',
  },
  {
    q: 'Can our ML team build this in-house?',
    a: 'Usually not without pulling people off the product. The generation pipeline is research work, a different specialisation from building the product model, and most teams do not have people to spare for it.',
  },
];
---

<V2Layout
  title="Synthetic data generation"
  description="We generate training, evaluation and red-team data for your domain, planned case by case so the edge cases are covered, checked row by row, and yours to keep."
  path="/services/synthetic-data"
  image="/simula-og.jpg"
>
  <!-- ═══ HERO: a pinned scroll on the indigo strata ═════════════ -->
  <section class="sh" data-sh>
    <div class="sh-stage" data-vsticky="0">
      <div class="sh-plate" aria-hidden="true">
        <canvas class="sh-sharp" data-backdrop="sdStrata" data-seed="4471" data-dpr="1"></canvas>
        <canvas class="sh-soft" data-backdrop="sdStrata" data-seed="4471" data-dpr="0.35"></canvas>
        <span class="sh-light l1"></span>
        <span class="sh-light l2"></span>
        <span class="sh-light l3"></span>
        <span class="sh-shade"></span>
      </div>

      <div class="sh-word" aria-hidden="true">
        <span class="sh-word-in">Synthetic data</span>
        <span class="sh-tag">Generated for your domain · Verified row by row</span>
      </div>

      <div class="sh-copy" data-sh-copy>
        <div class="shell sh-copy-in">
          <h1 class="sh-in">We generate the data your model is missing.</h1>
          <p class="sh-in d1">
            Training, evaluation and red-team data for your domain, planned case by case so the edge cases are covered.
            Every row is checked by a separate critic model, traced to how it was made, and yours to keep.
          </p>
          <div class="sh-actions sh-in d2">
            <a class="btn-l" href="/contact">
              <span class="btn-l-fill"></span>
              <span class="btn-l-label">Scope your dataset</span>
              <span class="btn-l-label" aria-hidden="true">→</span>
            </a>
            <a class="quiet on-dark" href="#generate">See what we generate<span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>

      <div class="sh-cue" aria-hidden="true">
        <span>Scroll</span>
        <i></i>
      </div>
    </div>
  </section>

  <!-- ═══ PROOF STRIP ════════════════════════════════════════════ -->
  <section class="strip-band">
    <div class="shell">
      <div class="strip" data-counts>
        {
          strip.map((s, i) => (
            <div class="strip-cell rv" data-rv style={`--rv-delay:${i * 80}ms`}>
              <span class="strip-fig">
                <span data-count={s.count} data-suffix={s.suffix}>
                  {s.count.toLocaleString('en-US')}
                  {s.suffix}
                </span>
              </span>
              <span class="strip-label">
                {s.label}
                <span>{s.note}</span>
              </span>
            </div>
          ))
        }
        <a class="strip-cell strip-link rv" data-rv style="--rv-delay:240ms" href={OSS_URL}>
          <span class="strip-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={ICON.map} />
          </span>
          <span>
            Our pipeline, Simula, is open source
            <b>See how it works →</b>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ THE PROBLEMS: six nodes, one hub ═══════════════════════ -->
  <section class="band band-tint" id="problems">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">The data problems we are brought in to solve.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">Most teams arrive with more than one. One dataset, planned properly, answers all six.</p>
      </div>

      <div class="nodes" data-nodes>
        <svg class="nodes-lines" aria-hidden="true"></svg>
        <figure class="hub rv" data-rv data-hub>
          <canvas data-backdrop="sdStrata" data-seed="918" data-dpr="1" aria-hidden="true"></canvas>
          <span class="hub-word">Your dataset</span>
          <span class="hub-note">Planned · Generated · Verified</span>
        </figure>
        {
          problems.map((p, i) => (
            <div
              class:list={['node rv', i < 3 ? 'node-l' : 'node-r']}
              data-rv
              data-from={i < 3 ? 'left' : 'right'}
              data-node={i}
              style={`--rv-delay:${120 + (i % 3) * 80}ms;grid-row:${(i % 3) + 1}`}
            >
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={ICON[p.icon]} />
              </span>
              <span class="node-text">
                <b>{p.title}</b>
                {p.line}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE GENERATE ═══════════════════════════════════════ -->
  <section class="band" id="generate">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">What we generate.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Text data for training and testing models, in whatever schema your pipeline takes.
        </p>
      </div>
      <div class="kinds">
        {
          kinds.map((k, i) => (
            <article class="kind rv" data-rv style={`--rv-delay:${60 + (i % 4) * 70}ms`}>
              <span class="kind-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={ICON[k.icon]} />
              </span>
              <h3>{k.title}</h3>
              <p>{k.line}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ HOW WE KEEP IT USABLE ══════════════════════════════════ -->
  <section class="band band-tint" id="quality">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Synthetic data fails in known ways. We check for each one.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          It starts with a map. Your domain is split into factors and each grows into a tree, so every case is planned
          before a single row is written.
        </p>
      </div>
      <CoverageTree />
      <div class="controls">
        <div class="controls-head" aria-hidden="true">
          <span>The known failure</span>
          <span>What we do about it</span>
        </div>
        {
          controls.map((c, i) => (
            <div class="control rv" data-rv style={`--rv-delay:${Math.min(i, 3) * 60}ms`}>
              <span class="control-risk">
                <span class="control-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={ICON[c.icon]} />
                </span>
                {c.risk}
              </span>
              <span class="control-fix">
                <i aria-hidden="true"></i>
                {c.fix}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ TWO WAYS TO START ══════════════════════════════════════ -->
  <section class="band" id="start">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Two ways to start.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">It depends on what you already have. Either way, the taxonomy comes first.</p>

      <div class="starts">
        {
          starts.map((s, i) => (
            <article class="start rv" data-rv data-from={i ? 'right' : 'left'} style={`--rv-delay:${140 + i * 80}ms`}>
              <figure class="start-art">
                {i === 0 ? (
                  <svg viewBox="0 0 400 276" role="img" aria-label="Existing data in two clusters, with two empty regions marked">
                    {scatter.map((p) => (
                      <circle class="pt" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.6" />
                    ))}
                    {gaps.map((g) => (
                      <g class="gap">
                        <circle cx={g.x} cy={g.y} r={g.r} />
                        <text x={g.x} y={g.y + 3.5}>
                          empty
                        </text>
                      </g>
                    ))}
                  </svg>
                ) : (
                  <svg viewBox="0 0 400 276" role="img" aria-label="A description split into three factors, each with three leaves">
                    {factorNodes.map((f) => (
                      <path class="ln" d={curve(ROOT, f)} />
                    ))}
                    {leafNodes.map((l) => (
                      <path class="ln" d={curve({ x: 168, y: l.fy }, l)} />
                    ))}
                    <rect class="root" x={ROOT.x - 7} y={ROOT.y - 7} width="14" height="14" />
                    <text class="lbl" x={ROOT.x - 8} y={ROOT.y + 26}>
                      your description
                    </text>
                    {factorNodes.map((f) => (
                      <g>
                        <circle class="fac" cx={f.x} cy={f.y} r="5" />
                        <text class="lbl" x={f.x - 10} y={f.y - 13}>
                          {f.label}
                        </text>
                      </g>
                    ))}
                    {leafNodes.map((l) => (
                      <circle class="leaf" cx={l.x} cy={l.y} r="4.5" />
                    ))}
                  </svg>
                )}
              </figure>
              <div class="start-body">
                <span class="start-key">{s.key}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <ol class="start-steps">
                  {s.steps.map((st) => (
                    <li>{st}</li>
                  ))}
                </ol>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ HOW AN ENGAGEMENT RUNS ═════════════════════════════════ -->
  <section class="band band-tint" id="loop">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">We build it with you, in rounds.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">A build and review loop, not a single handoff. You see the data before the full volume is generated.</p>

      <div class="loop" data-loop>
        <div class="loop-rail" aria-hidden="true"><span class="loop-fill"></span></div>
        <ol class="loop-steps">
          {
            loopSteps.map((s, i) => (
              <li class="loop-step" data-step={i}>
                <span class="loop-node" aria-hidden="true"></span>
                <span class="loop-n">0{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
        <div class="loop-back" aria-hidden="true">
          <svg viewBox="0 0 1000 56" preserveAspectRatio="none">
            <path pathLength="1" d="M672 0 V30 Q672 46 656 46 H16 Q0 46 0 30 V2"></path>
          </svg>
          <span class="loop-arrow"></span>
          <span class="loop-label">Repeat until your team signs off</span>
        </div>
      </div>

      <div class="deliver rv" data-rv>
        <h3>What you receive</h3>
        <ul>
          {
            deliverables.map((d) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>
                {d}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ BUILT ON SIMULA ════════════════════════════════════════ -->
  <section class="band" id="simula">
    <div class="shell sim">
      <figure class="plate rv" data-rv data-from="left">
