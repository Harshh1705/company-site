---

<V2Layout
  title="Synthetic data generation"
  description="We generate training, evaluation and red-team data for your domain, planned case by case so the edge cases are covered, checked row by row, and yours to keep."
  path="/services/synthetic-data"
  image="/simula-og.jpg"
>
  <!-- ═══ HERO: a pinned scroll on the indigo strata ═════════════ -->
  <section class="sh" data-sh>
    <div class="sh-stage" data-vsticky="0">
      <div class="sh-plate" aria-hidden="true">
        <canvas class="sh-sharp" data-backdrop="sdStrata" data-seed="4471" data-dpr="1"></canvas>
        <canvas class="sh-soft" data-backdrop="sdStrata" data-seed="4471" data-dpr="0.35"></canvas>
        <span class="sh-light l1"></span>
        <span class="sh-light l2"></span>
        <span class="sh-light l3"></span>
        <span class="sh-shade"></span>
      </div>

      <div class="sh-copy" data-sh-copy data-live="true">
        <div class="shell sh-copy-in">
          <h1 class="sh-in">We generate the data your model is missing.</h1>
          <p class="sh-in d1">
            Training, evaluation and red-team data for your domain, planned case by case so the edge cases are covered.
            Every row is checked by a separate critic model, traced to how it was made, and yours to keep.
          </p>
          <div class="sh-actions sh-in d2">
            <a class="btn-l" href="/contact">
              <span class="btn-l-fill"></span>
              <span class="btn-l-label">Scope your dataset</span>
              <span class="btn-l-label" aria-hidden="true">→</span>
            </a>
            <a class="quiet on-dark" href="#generate">See what we generate<span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>

      <div class="sh-cue" aria-hidden="true">
        <span>Scroll</span>
        <i></i>
      </div>
    </div>
  </section>

  <!-- ═══ PROOF STRIP ════════════════════════════════════════════ -->
  <section class="strip-band">
    <div class="shell">
      <div class="strip" data-counts>
        {
          strip.map((s, i) => (
            <div class="strip-cell rv" data-rv style={`--rv-delay:${i * 80}ms`}>
              <span class="strip-fig">
                <span data-count={s.count} data-suffix={s.suffix}>
                  {s.count.toLocaleString('en-US')}
                  {s.suffix}
                </span>
              </span>
              <span class="strip-label">
                {s.label}
                <span>{s.note}</span>
              </span>
            </div>
          ))
        }
        <a class="strip-cell strip-link rv" data-rv style="--rv-delay:240ms" href={OSS_URL}>
          <span class="strip-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={ICON.map} />
          </span>
          <span>
            Our pipeline, Simula, is open source
            <b>See how it works →</b>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ THE PROBLEMS: six nodes, one hub ═══════════════════════ -->
  <section class="band band-tint wash" id="problems">
    <canvas class="wash-bg" data-backdrop="sdWash" data-seed="2207" data-dpr="0.6" aria-hidden="true"></canvas>
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">The data problems we are brought in to solve.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">Most teams arrive with more than one. One dataset, planned properly, answers all six.</p>
      </div>

      <div class="nodes" data-nodes>
        <svg class="nodes-lines" aria-hidden="true"></svg>
        <figure class="hub rv" data-rv data-hub>
          <canvas data-backdrop="sdStrata" data-seed="918" data-dpr="1" aria-hidden="true"></canvas>
          <span class="hub-word">Your dataset</span>
          <span class="hub-note">Planned · Generated · Verified</span>
        </figure>
        {
          problems.map((p, i) => (
            <div
              class:list={['node rv', i < 3 ? 'node-l' : 'node-r']}
              data-rv
              data-from={i < 3 ? 'left' : 'right'}
              data-node={i}
              style={`--rv-delay:${120 + (i % 3) * 80}ms;grid-row:${(i % 3) + 1}`}
            >
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={ICON[p.icon]} />
              </span>
              <span class="node-text">
                <b>{p.title}</b>
                {p.line}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE GENERATE ═══════════════════════════════════════ -->
  <section class="band" id="generate">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">What we generate.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Text data for training and testing models, in whatever schema your pipeline takes.
        </p>
      </div>
      <div class="kinds">
        {
          kinds.map((k, i) => (
            <article class="kind rv" data-rv style={`--rv-delay:${60 + (i % 4) * 70}ms`}>
              <span class="kind-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={ICON[k.icon]} />
              </span>
              <h3>{k.title}</h3>
              <p>{k.line}</p>
            </article>
          ))
        }
      </div>
