const faqs = [
  {
    q: 'Will training on synthetic data degrade our model?',
    a: 'Degradation comes from a model training on its own unchecked output, round after round. We generate against a plan, check every row with a separate critic model, and judge each round against an evaluation we agree with you before scaling up.',
  },
  {
    q: 'Do you need access to our data?',
