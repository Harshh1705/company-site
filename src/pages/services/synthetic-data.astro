<script is:inline>
  /* ── Scroll-driven pieces ────────────────────────────────────────
     The hero (ground frosts, then the copy blurs away) and the loop
     rail follow the scroll.
     Under the layout's virtual scroll, `v2scroll` fires inside its own
     frame after the wrapper moves, so we update synchronously there;
     native scrolling goes through one rAF. */
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const set = (el, k, v) => el.style.setProperty(k, v.toFixed(4));

    const hero = document.querySelector('[data-sh]');
    const stage = hero && hero.querySelector('.sh-stage');
    const copy = hero && hero.querySelector('[data-sh-copy]');
    const loop = document.querySelector('[data-loop]');
    const steps = loop ? [...loop.querySelectorAll('[data-step]')] : [];

    if (reduce) {
      if (hero) copy.dataset.live = 'true';
      if (loop) {
        set(loop, '--r', 1);
        set(loop, '--arc', 1);
        steps.forEach((s) => (s.dataset.on = 'true'));
      }
      return;
    }

    const update = () => {
      const vh = window.innerHeight;
      if (hero) {
        const r = hero.getBoundingClientRect();
        const span = r.height - stage.offsetHeight;
        const p = span > 0 ? clamp(-r.top / span) : 1;
        set(hero, '--a', ease(clamp(p / 0.5)));
        // Ease in, so the copy holds and then leaves quickly.
        const o = clamp((p - 0.45) / 0.5);
        set(hero, '--o', o * o);
        copy.dataset.live = o < 0.5 ? 'true' : 'false';
      }
      if (loop) {
        const r = loop.getBoundingClientRect();
        const t = clamp((vh * 0.82 - r.top) / (vh * 0.5));
        set(loop, '--r', t);
        set(loop, '--arc', clamp((t - 0.82) / 0.18));
        steps.forEach((s, i) => (s.dataset.on = t >= i / 3 + 0.02 ? 'true' : 'false'));
      }
    };

    let raf = 0;
    const req = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
    };
    window.addEventListener('scroll', () => (document.documentElement.dataset.vscroll ? null : req()), {
      passive: true,
    });
    window.addEventListener('v2scroll', update);
    window.addEventListener('resize', req);
    update();
  })();

  /* ── Problem nodes: a curve from the hub to each node, drawn when
     the figure comes into view, with a pulse running out along it. ── */
  (() => {
    const root = document.querySelector('[data-nodes]');
    if (!root) return;
    const svg = root.querySelector('.nodes-lines');
    const hub = root.querySelector('[data-hub]');
    const nodes = [...root.querySelectorAll('[data-node]')];
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const build = () => {
      svg.replaceChildren();
      if (getComputedStyle(svg).display === 'none') return;
      /* Layout offsets, not client rects: the reveal and the virtual
         scroll both move things with transforms, which offsets ignore. */
      svg.setAttribute('viewBox', `0 0 ${root.offsetWidth} ${root.offsetHeight}`);
      const hx = hub.offsetLeft;
      const hy = hub.offsetTop;
      nodes.forEach((n, i) => {
        const left = n.classList.contains('node-l');
        const row = i % 3;
        const x1 = left ? hx : hx + hub.offsetWidth;
        const y1 = hy + hub.offsetHeight * (0.3 + row * 0.2);
        const x2 = left ? n.offsetLeft + n.offsetWidth : n.offsetLeft;
        const y2 = n.offsetTop + n.offsetHeight / 2;
        const mx = (x1 + x2) / 2;
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', `M${x1} ${y1} C${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`);
        path.setAttribute('pathLength', '1');
        path.setAttribute('id', 'np-' + i);
        path.style.transitionDelay = 200 + row * 120 + 'ms';
        svg.appendChild(path);
        [x1, x2].forEach((x, j) => {
          const dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('cx', x);
          dot.setAttribute('cy', j ? y2 : y1);
          dot.setAttribute('r', '3');
          dot.setAttribute('class', 'end');
          svg.appendChild(dot);
        });
        if (reduce) return;
        const pulse = document.createElementNS(NS, 'circle');
        pulse.setAttribute('r', '3.2');
        pulse.setAttribute('class', 'pulse');
        const move = document.createElementNS(NS, 'animateMotion');
        move.setAttribute('dur', '2.8s');
        move.setAttribute('repeatCount', 'indefinite');
        move.setAttribute('begin', -(i * 0.47).toFixed(2) + 's');
        move.setAttribute('keyPoints', '0;1');
        move.setAttribute('keyTimes', '0;1');
        move.setAttribute('calcMode', 'spline');
        move.setAttribute('keySplines', '0.4 0 0.2 1');
        const mpath = document.createElementNS(NS, 'mpath');
        mpath.setAttribute('href', '#np-' + i);
        move.appendChild(mpath);
        pulse.appendChild(move);
        svg.appendChild(pulse);
      });
    };

    let t;
    const rebuild = () => {
      clearTimeout(t);
      t = setTimeout(build, 80);
    };
    if ('ResizeObserver' in window) new ResizeObserver(rebuild).observe(root);
    else window.addEventListener('resize', rebuild);
    build();

    if (!('IntersectionObserver' in window) || reduce) {
      root.dataset.on = 'true';
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        root.dataset.on = 'true';
        io.disconnect();
      },
      { threshold: 0.35 }
    );
    io.observe(root);
  })();

  /* ── Counters: count up once, when their strip comes into view. ── */
  (() => {
    const groups = [...document.querySelectorAll('[data-counts]')];
    if (!groups.length || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const fmt = (n) => Math.round(n).toLocaleString('en-US');
    const run = (n) => {
      const to = Number(n.dataset.count);
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 1400);
        n.textContent = fmt(to * (1 - Math.pow(1 - k, 4))) + n.dataset.suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.querySelectorAll('[data-count]').forEach(run);
          io.unobserve(e.target);
        });
      },
      { threshold: 0.4 }
    );
    groups.forEach((g) => {
      g.querySelectorAll('[data-count]').forEach((n) => (n.textContent = '0' + n.dataset.suffix));
      io.observe(g);
    });
  })();
</script>

<style>
  /* ── Shared bits ───────────────────────────────────────────── */
  section .h2 {
    margin-top: 0;
  }
  .lede {
    text-wrap: pretty;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  svg :global(path),
  svg :global(rect),
  svg :global(circle),
  svg :global(ellipse) {
    vector-effect: non-scaling-stroke;
  }
  .split-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 46ch);
    gap: 18px clamp(36px, 5vw, 72px);
    align-items: end;
  }
  .split-head .lede {
    margin-top: 0;
    padding-bottom: 5.4px;
  }
  @media (max-width: 860px) {
    .split-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 7.2px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 300ms var(--ease);
  }
  .quiet span {
    transition: transform 400ms var(--ease);
  }
  .quiet:hover {
    color: var(--ink);
  }
  .quiet:hover span {
    transform: translateX(4px);
  }
  .quiet.on-dark {
    color: hsl(0 0% 100% / 0.82);
  }
  .quiet.on-dark:hover {
    color: #fff;
  }
  /* Icons: 24-grid line drawings, indigo. */
  .node-icon svg,
  .kind-icon svg,
  .control-icon svg,
  .strip-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Light button for indigo grounds. It wipes black left to right on
     hover, like every other button on the site. */
  .btn-l {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14.5px 25.2px;
    background: var(--n-50);
    color: var(--n-900);
    border: 1px solid var(--n-50);
    font-size: 11.2px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      color 300ms var(--ease),
      border-color 300ms var(--ease);
  }
  .btn-l-fill {
    position: absolute;
    inset: 0;
    background: var(--n-900);
    transform: translateX(-100%);
    transition: transform 350ms var(--ease);
  }
  .btn-l-label {
    position: relative;
    z-index: 1;
  }
  .btn-l:hover {
    color: var(--n-50);
    border-color: var(--n-900);
  }
  .btn-l:hover .btn-l-fill {
    transform: translateX(0);
  }

  /* ══ HERO ═══════════════════════════════════════════════════════
     The headline is the first screen: it comes into focus on load.
     The section is taller than the screen and the stage pins for the
     extra height. --a runs 0 → 1 as the ground frosts over, then --o
     as the copy blurs away and the next section takes over. */
  .sh {
    --a: 0;
    --o: 0;
    position: relative;
    height: 190svh;
    background: var(--indigo-700);
  }
  .sh-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: #fff;
    will-change: transform;
  }
  /* Under virtual scroll the layout emulates the stick with a
     transform (data-vsticky), so the stage needs a plain box. */
  :global(html[data-vscroll]) .sh-stage {
    position: relative;
  }
  .sh-plate {
    position: absolute;
    inset: 0;
    background: var(--indigo-600);
  }
  .sh-plate canvas {
    position: absolute;
    width: 100%;
    height: 100%;
  }
  .sh-sharp {
    inset: 0;
  }
  /* The same ground at a third of the resolution, blurred, and faded
     in over the sharp one. A crossfade is far cheaper than animating
     a blur across the whole screen. */
  .sh-plate .sh-soft {
    inset: -8%;
    width: 116%;
    height: 116%;
    filter: blur(26px) saturate(1.15) brightness(1.06);
    opacity: var(--a);
  }
  /* Soft lights drifting on the ground. Indigo and white only. */
  .sh-light {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(70px);
    mix-blend-mode: screen;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .sh-light.l1 {
    width: 46vw;
    height: 46vw;
    left: -10vw;
    top: -16vw;
    background: hsl(243 90% 72% / 0.45);
  }
  .sh-light.l2 {
    width: 38vw;
    height: 38vw;
    right: -8vw;
    bottom: -14vw;
    background: hsl(240 60% 90% / 0.26);
    animation-duration: 28s;
    animation-delay: -9s;
  }
  .sh-light.l3 {
    width: 30vw;
    height: 30vw;
    left: 38vw;
    top: 30%;
    background: hsl(250 80% 64% / 0.3);
    animation-duration: 34s;
    animation-delay: -17s;
    opacity: calc(0.4 + var(--a) * 0.6);
  }
  @keyframes drift {
    to {
      transform: translate3d(6vw, 4vw, 0) scale(1.12);
    }
  }
  /* Deepens the left behind the copy, for contrast. */
  .sh-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, hsl(243 80% 14% / 0.6) 0%, hsl(243 80% 14% / 0.2) 55%, transparent 100%);
  }
  @keyframes focus-in {
    from {
      opacity: 0;
      filter: blur(24px);
      transform: scale(1.05);
    }
  }

  /* Padded by the nav's height so the copy sits in the middle of what
     is visible before the stage pins. */
  .sh-copy {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-bottom: var(--nav-h);
    pointer-events: none;
  }
  .sh-copy[data-live='true'] {
    pointer-events: auto;
  }
  /* The scroll drives the wrapper; the load intro runs on the lines
     inside it, so the two never fight over the same properties. */
  .sh-copy-in {
    width: 100%;
    opacity: calc(1 - var(--o));
    filter: blur(calc(var(--o) * 18px));
    transform: translateY(calc(var(--o) * -6vh)) scale(calc(1 - var(--o) * 0.03));
  }
  .sh-in {
    animation: focus-in 1400ms var(--ease) 120ms both;
  }
  .sh-in.d1 {
    animation-delay: 320ms;
  }
  .sh-in.d2 {
    animation-delay: 520ms;
  }
  /* A keyboard user tabbing into the buttons sees them, whatever
     the scroll position. */
  .sh-copy:focus-within .sh-copy-in {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .sh-copy h1 {
    max-width: 16ch;
    font-family: var(--hero-serif);
    font-size: clamp(36px, 5.6vw, 72px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.028em;
    text-wrap: balance;
    text-shadow: 0 10px 40px hsl(243 80% 16% / 0.35);
  }
  .sh-copy p {
    margin-top: 24px;
    max-width: 56ch;
    font-size: clamp(14.85px, 1.4vw, 16.65px);
    line-height: 1.74;
    color: hsl(0 0% 100% / 0.86);
    text-wrap: pretty;
  }
  .sh-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 27px;
    margin-top: 34px;
  }

  .sh-cue {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--nav-h) + 26px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: hsl(0 0% 100% / 0.7);
    opacity: calc(1 - var(--a) * 2.5);
  }
  /* The intro runs on the children so it never fights the scroll fade. */
  .sh-cue > * {
    animation: focus-in 1200ms var(--ease) 1100ms both;
  }
  .sh-cue i {
    position: relative;
    display: block;
    width: 1px;
    height: 42px;
    overflow: hidden;
    background: hsl(0 0% 100% / 0.25);
  }
  .sh-cue i::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: #fff;
    animation: cue 2200ms var(--ease) infinite;
  }
  @keyframes cue {
    to {
      top: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh {
      height: auto;
    }
    .sh-stage {
      position: relative;
    }
    .sh-cue {
      display: none;
    }
    .sh-light,
    .sh-in {
      animation: none;
    }
  }

  /* ══ PROOF STRIP ═════════════════════════════════════════════ */
  .strip-band {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.25fr);
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .strip-cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px 24px 28px;
    border-right: 1px solid var(--line);
  }
  .strip-fig {
    display: block;
    font-family: var(--hero-serif);
    font-size: clamp(34px, 3.6vw, 46px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--teal-700);
    font-variant-numeric: tabular-nums;
  }
  .strip-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .strip-label span {
    display: block;
    margin-top: 3px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 400;
    color: var(--n-400);
  }
  .strip-link {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    background: var(--n-50);
    transition: background 400ms var(--ease);
  }
  .strip-link:hover {
    background: var(--indigo-100);
  }
  .strip-icon {
    flex: none;
    width: 38px;
    height: 38px;
    padding: 8px;
    color: var(--indigo-600);
    border: 1px solid var(--indigo-200);
    background: var(--surface);
  }
  .strip-link > span:last-child {
    font-family: var(--hero-serif);
    font-size: 17.1px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .strip-link b {
    display: block;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--indigo-600);
  }
  @media (max-width: 900px) {
    .strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .strip-link {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
    }
    .strip-cell + .strip-cell {
      border-top: 1px solid var(--line);
    }
  }

  /* ══ PROBLEMS: three nodes a side, the hub in the middle ═════ */
  .nodes {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px) minmax(0, 1fr);
    grid-template-rows: repeat(3, auto);
    gap: 22px clamp(56px, 8vw, 120px);
    align-items: center;
    margin-top: 52px;
  }
  .nodes-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .nodes-lines :global(path) {
    fill: none;
    stroke: var(--indigo-300);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1100ms var(--ease);
  }
  .nodes[data-on='true'] .nodes-lines :global(path) {
    stroke-dashoffset: 0;
  }
  .nodes-lines :global(.end) {
    fill: var(--indigo-500);
    opacity: 0;
    transition: opacity 600ms var(--ease) 900ms;
  }
  .nodes[data-on='true'] .nodes-lines :global(.end) {
    opacity: 1;
  }
  .nodes-lines :global(.pulse) {
    fill: var(--indigo-600);
    opacity: 0;
    transition: opacity 600ms var(--ease) 1400ms;
  }
  .nodes[data-on='true'] .nodes-lines :global(.pulse) {
    opacity: 1;
  }
  .hub {
    position: relative;
    grid-column: 2;
    grid-row: 1 / 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    color: #fff;
    background: var(--indigo-600);
    box-shadow: 0 30px 70px -36px hsl(243 80% 20% / 0.6);
  }
  .hub canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hub-word,
  .hub-note {
    position: relative;
  }
  .hub-word {
    font-family: var(--hero-serif);
    font-style: italic;
    font-size: clamp(28px, 2.8vw, 36px);
    letter-spacing: -0.02em;
    text-shadow: 0 8px 26px hsl(243 80% 16% / 0.5);
  }
  .hub-note {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(0 0% 100% / 0.78);
  }
  .node {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    transition:
      transform 500ms var(--ease),
      border-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .node-l {
    grid-column: 1;
  }
  .node-r {
    grid-column: 3;
  }
  .node:hover {
    transform: translateY(-1.2px);
    border-color: var(--indigo-300);
    box-shadow: 0 10px 24px -16px hsl(243 60% 30% / 0.35);
  }
  .node-icon {
    flex: none;
    width: 42px;
    height: 42px;
    padding: 9px;
    color: var(--indigo-600);
    background: var(--indigo-100);
  }
  .node-text {
    font-size: 13.05px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .node-text b {
    display: block;
    margin-bottom: 2px;
    font-family: var(--hero-serif);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: 12px;
    }
    .nodes-lines {
      display: none;
    }
    .hub {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 21 / 8;
      margin-bottom: 8px;
    }
    .node,
    .node-l,
    .node-r {
      grid-column: auto;
      grid-row: auto !important;
    }
  }
  @media (max-width: 520px) {
    .nodes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ WHAT WE GENERATE ════════════════════════════════════════ */
  .kinds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 46.8px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .kind {
    position: relative;
    padding: 24px 22px 26px;
    background: var(--surface);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background 400ms var(--ease);
  }
  .kind::before {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    top: -1px;
    height: 2px;
    background: var(--indigo-600);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }
  .kind:hover {
    background: var(--n-50);
  }
  .kind:hover::before {
    transform: scaleX(1);
  }
  .kind-icon {
    display: block;
    width: 30px;
    height: 30px;
    color: var(--indigo-600);
    transition: transform 500ms var(--ease);
  }
  .kind:hover .kind-icon {
    transform: translateY(-2px);
  }
  .kind h3 {
    margin-top: 22px;
    font-family: var(--hero-serif);
    font-size: 18.9px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .kind p {
    margin-top: 8px;
    font-size: 12.6px;
    line-height: 1.65;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  @media (max-width: 1000px) {
    .kinds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .kinds {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ WASH: "All three" from /design.html (blur → dither → grain)
     as a light colour field behind sections whose content sits on
     white cards. The canvas is drawn at low resolution; the dither
     and grain carry the texture. Content stacks above it. */
  .wash {
    position: relative;
    overflow: hidden;
  }
  .wash-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wash > :not(.wash-bg) {
    position: relative;
    z-index: 1;
  }
  /* Labels in the domains band sat on the flat tint; on the wash they
     get a white ground so they still read as chips. */
  .wash .uses li {
    background: hsl(0 0% 100% / 0.85);
  }
  .wash .mq {
    background: hsl(0 0% 100% / 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* ══ PUBLISHED DATASETS ══════════════════════════════════════
     Four staggered columns of tiles. Each tile: a dot and the name,
     the row count, a preview of the first row in mono (keys indigo,
     values teal, as in the site's code blocks), then one line of
     description pinned to the bottom. Square and hairline, like every
     other card on the site. */
  /* A wider measure than the site's shell, so each tile has room. */
  #datasets {
    --shell: 1340px;
  }
  .ds-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 36px;
    flex-wrap: wrap;
  }
  .ds-head > div {
    flex: 1 1 30rem;
    min-width: 0;
  }
  .ds-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 46.8px;
    align-items: start;
  }
  .ds-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ds-col:nth-child(even) {
    padding-top: 56px;
  }
  .ds-tile {
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 22px 20px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      transform 500ms var(--ease),
      border-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .ds-tile:hover {
    transform: translateY(-2px);
    border-color: var(--indigo-300);
    box-shadow: 0 16px 34px -24px hsl(243 60% 30% / 0.35);
  }
  .ds-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ds-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .dot-indigo {
    background: var(--indigo-500);
  }
  .dot-teal {
    background: var(--teal-500);
  }
  .dot-neutral {
    background: var(--n-400);
  }
  .ds-name {
    font-family: var(--hero-serif);
    font-size: 19.8px;
    line-height: 1.2;
    letter-spacing: -0.014em;
    color: var(--ink);
  }
  .ds-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 7px;
    margin-top: 8px;
    padding-left: 17px;
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .ds-meta svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ds-kind {
    color: var(--n-400);
  }
  .ds-kind::before {
    content: '· ';
  }
  /* The first row, as the Hub shows it, trimmed to one line a field. */
  .ds-snap {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 18px;
    padding: 11px 12px;
    background: var(--n-50);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10.35px;
    line-height: 1.45;
    transition: border-color 500ms var(--ease);
  }
  .ds-tile:hover .ds-snap {
    border-color: var(--indigo-200);
  }
  .ds-line {
    display: flex;
    min-width: 0;
    gap: 8px;
  }
  .ds-line b {
    flex: none;
    font-weight: 500;
    color: var(--indigo-600);
  }
  .ds-line i {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-style: normal;
    color: var(--teal-800);
  }
  .ds-empty {
    color: var(--n-400);
  }
  .ds-badge {
    align-self: flex-start;
    margin-top: 12px;
    padding: 3px 8px;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--indigo-600);
  }
  .ds-desc {
    margin-top: auto;
    padding-top: 22px;
    font-size: 13.05px;
    line-height: 1.65;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  @media (max-width: 1000px) {
    .ds-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .ds-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ds-col:nth-child(even) {
      padding-top: 0;
    }
    .ds-tile {
      min-height: 0;
    }
  }

  /* ══ QUALITY ═════════════════════════════════════════════════ */
  .controls {
    margin-top: 44px;
  }
  .controls-head,
  .control {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 0 clamp(28px, 4vw, 54px);
  }
  .controls-head {
    padding-bottom: 12px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--n-400);
  }
  .control {
    align-items: center;
    padding-block: 16px;
    border-top: 1px solid var(--line-2);
  }
  .control:last-child {
    border-bottom: 1px solid var(--line-2);
  }
  .control-risk {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--hero-serif);
    font-size: 18px;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .control-icon {
    flex: none;
    width: 34px;
    height: 34px;
    padding: 7px;
    color: var(--ink-3);
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .control-fix {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .control-fix i {
    flex: none;
    width: 26px;
    height: 1px;
    background: var(--indigo-500);
    position: relative;
  }
  .control-fix i::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--indigo-500);
    border-right: 1px solid var(--indigo-500);
    transform: rotate(45deg);
  }
  @media (max-width: 760px) {
    .controls-head {
      display: none;
    }
    .control {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .control-fix i {
      display: none;
    }
    .control-fix {
      padding-left: 48px;
    }
  }

  /* ══ TWO WAYS TO START: side by side, both visible ═══════════ */
  .starts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 40px;
  }
  .start {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .start-art {
    margin: 0;
    padding: 22px 26px;
    background: var(--n-50);
    border-bottom: 1px solid var(--line);
  }
  .start-art svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 250px;
    overflow: visible;
  }
  .start-art .pt {
    fill: var(--teal-500);
    opacity: 0.72;
  }
  .start-art .gap circle {
    fill: hsl(34 84% 53% / 0.08);
    stroke: var(--amber-500);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
    transform-box: fill-box;
    transform-origin: center;
    animation: breathe 3.2s ease-in-out infinite;
  }
  .start-art .gap text {
    font-family: var(--mono);
    font-size: 10px;
    text-anchor: middle;
